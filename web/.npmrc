# Foresight pnpm configuration — security-hardened defaults.
# Reference: https://pnpm.io/npmrc
#
# Auto-install peer dependencies declared by packages so we never accidentally
# drift into a "phantom peer" situation where a transitive package's required
# peer is missing at runtime.
auto-install-peers=true

# Reject installs when a peer dependency requirement is unsatisfied. Catches
# version mismatches at install time rather than at first import in prod.
strict-peer-dependencies=true

# Disable lifecycle scripts (preinstall / install / postinstall) by default.
# Lifecycle scripts in transitive dependencies are a top npm supply-chain
# attack vector. Specific packages that genuinely need them must be
# allow-listed via `onlyBuiltDependencies` in package.json.
enable-pre-post-scripts=false

# Verify that packages in the content-addressable store match their integrity
# hashes before linking them into node_modules. Detects tampered cache.
verify-store-integrity=true

# Save resolved versions deterministically; no fuzzy upgrades on `pnpm add`.
save-exact=false
save-prefix=^

# Use frozen lockfile when CI=true; locally fall back to the lockfile but
# update it if needed. Together with verify-store-integrity, this is the
# floor for reproducible installs.
prefer-frozen-lockfile=true

# Don't enforce the `engines` field for now (developer machines may use Node
# 25 or other recent versions). The pin in package.json documents intent;
# CI / Docker will run on Node 22 LTS where the range matches exactly.
engine-strict=false
