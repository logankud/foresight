# Foresight local development environment variables.
#
# Copy this file to `.env` (gitignored) and fill in any secrets. The
# defaults below match `infra/compose/docker-compose.yml` so a fresh
# clone works without edits.
#
# Required variables fail-fast on app startup with a clear error message
# when missing. Optional variables fall back to safe defaults.

# ----- Postgres (local Compose) -----
# Used by docker-compose and by the future SQLAlchemy session factory (E2.S3).
POSTGRES_USER=foresight
POSTGRES_PASSWORD=foresight-dev
POSTGRES_DB=foresight

# Connection URL consumed by `foresight.core` (lands in E2.S3). The host
# matches the compose service name when run from inside the network;
# defaults to `localhost` here for host-side tooling (pytest, alembic).
DATABASE_URL=postgresql+psycopg://foresight:foresight-dev@localhost:5432/foresight

# ----- App environment -----
# Drives settings resolution. `local` reads from this file; `dev` / `prod`
# read from AWS Secrets Manager (lands in E9.S5).
APP_ENV=local

# ----- Future variables (kept here as documentation; safe to leave blank for E2) -----

# Shopify integration (E4.S2):
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPIFY_APP_HANDLE=

# Anthropic / agent layer (E6.S2):
# ANTHROPIC_API_KEY=

# Slack adapter (E6.S4):
# SLACK_SIGNING_SECRET=
# SLACK_BOT_TOKEN=

# AWS (E9):
# AWS_REGION=us-east-1
# AWS_PROFILE=foresight-dev
